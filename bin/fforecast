#!/usr/bin/env python3

from copy import deepcopy
from calendar import monthrange
import json
import datetime
from dateutil.relativedelta import relativedelta
import argparse
import os

try:
    import readline  # noqa: F401  (line editing/history for input())
except ImportError:
    pass

FREQUENCIES = [
    "daily",
    "weekdays",
    "weekly",
    "bi-weekly",
    "monthly",
    "yearly",
    "one-time"
]


def input_float(prompt, default=None):
    while True:
        raw = input(prompt).strip()
        if raw == "" and default is not None:
            return default
        try:
            return float(raw)
        except ValueError:
            print(f"Invalid amount: {raw!r}. Enter a number like 1234.56")


def input_date(prompt, allow_empty=False, default=None):
    while True:
        raw = input(prompt).strip()
        if raw == "":
            if default is not None:
                return default
            if allow_empty:
                return ""
            print("A date is required (YYYY-MM-DD).")
            continue
        try:
            datetime.datetime.strptime(raw, '%Y-%m-%d')
            return raw
        except ValueError:
            print(f"Invalid date: {raw!r}. Use YYYY-MM-DD.")


def input_yes_no(prompt, default=False):
    raw = input(prompt).lower().strip()
    if raw == "":
        return default
    return raw in ('y', 'yes')


def load_data(filename):
    try:
        with open(filename, 'r') as f:
            return json.load(f)
    except FileNotFoundError:
        return {
            "accounts": {},
            "income": [],
            "expenses": [],
            "default-expense-account": "",
            "default-income-account": "",
        }


def save_data(data, filename):
    with open(filename, 'w') as f:
        json.dump(data, f, indent=2)


def add_account(data):
    name = input("Enter account name: ")
    balance = input_float("Enter current balance: ")
    data["accounts"][name] = balance
    if not data.get("default-income-account"):
        data["default-income-account"] = name
    else:
        if input_yes_no("Make default income account? (y/N): "):
            data["default-income-account"] = name
    if not data.get("default-expense-account"):
        data["default-expense-account"] = name
    else:
        if input_yes_no("Make default expense account? (y/N): "):
            data["default-expense-account"] = name


def matched_frequency(start_date, end_date, current_date, frequency):
    """Return True if `current_date` is an occurrence of the recurrence
    that began on `start_date` with `frequency`. `end_date` (optional)
    caps the recurrence.
    """
    if start_date > current_date:
        return False
    if end_date and end_date < current_date:
        return False
    if frequency == 'daily':
        return True
    if frequency == 'weekdays':
        # 0-4 are Monday-Friday
        return current_date.weekday() < 5
    if frequency == 'weekly':
        return (current_date - start_date).days % 7 == 0
    if frequency == 'bi-weekly':
        return (current_date - start_date).days % 14 == 0
    if frequency == 'monthly':
        # Clamp the target day to the last valid day of the current
        # month so day-31 entries still fire in 30-day months, etc.
        last_day = monthrange(current_date.year, current_date.month)[1]
        target_day = min(start_date.day, last_day)
        return current_date.day == target_day
    if frequency == 'yearly':
        # Handle Feb 29 gracefully on non-leap years by clamping to the
        # last day of the target month.
        target_month = start_date.month
        if current_date.month != target_month:
            return False
        last_day = monthrange(current_date.year, target_month)[1]
        target_day = min(start_date.day, last_day)
        return current_date.day == target_day
    if frequency == 'one-time':
        return current_date == start_date
    raise Exception(f"Unknown frequency {frequency}")


def calculate_amount(event):
    if 'transactions' in event:
        return sum(v for v in event['transactions'].values())
    return event['amount']


def _resolve_account(txn, accounts, default_account):
    """Pick the account this transaction posts to.

    Honor `txn['account']` when present and known; otherwise fall back
    to the caller-provided default (which is the file-level default).
    """
    account = txn.get('account')
    if account and account in accounts:
        return account
    return default_account


def generate_forecast(data, months):
    # Deepcopy FIRST so any downstream mutation (calculate_amount,
    # balance updates) never leaks back into the caller's data.
    data = deepcopy(data)

    # Roll up sub-transactions into their parent's `amount`.
    for key in ['income', 'expenses']:
        for transaction in data[key]:
            transaction['amount'] = calculate_amount(transaction)

    # Normalize: support legacy {"balance": X} dicts and plain numbers.
    accounts = {
        name: (value["balance"] if isinstance(value, dict) else value)
        for name, value in data["accounts"].items()
    }
    if not accounts:
        raise ValueError("No accounts defined; add one before forecasting.")

    default_income_account = (
        data.get('default-income-account')
        or next(iter(accounts))
    )
    default_expense_account = (
        data.get('default-expense-account')
        or next(iter(accounts))
    )

    start_date = datetime.date.today()
    end_date = start_date + relativedelta(months=months)
    current_date = start_date

    forecast = []
    while current_date <= end_date:
        events = []
        for income in data["income"]:
            frequency = income['frequency']
            next_date = datetime.datetime.strptime(
                income['next_date'], '%Y-%m-%d').date()
            last_date = income.get('end_date') or None
            if last_date:
                last_date = datetime.datetime.strptime(
                    last_date, '%Y-%m-%d').date()
            if matched_frequency(next_date, last_date, current_date, frequency):
                acct = _resolve_account(
                    income, accounts, default_income_account)
                accounts[acct] += income['amount']
                events.append({
                    'type': 'income',
                    'name': income['name'],
                    'amount': income['amount'],
                    'account_name': acct,
                    'account_balance': accounts[acct]
                })

        for expense in data["expenses"]:
            frequency = expense['frequency']
            next_date = datetime.datetime.strptime(
                expense['next_date'], '%Y-%m-%d').date()
            last_date = expense.get('end_date') or None
            if last_date:
                last_date = datetime.datetime.strptime(
                    last_date, '%Y-%m-%d').date()
            if matched_frequency(next_date, last_date, current_date, frequency):
                acct = _resolve_account(
                    expense, accounts, default_expense_account)
                accounts[acct] -= expense['amount']
                events.append({
                    'type': 'expense',
                    'name': expense['name'],
                    'amount': expense['amount'],
                    'account_name': acct,
                    'account_balance': accounts[acct]
                })

        forecast.append({
            "date": current_date.strftime("%Y-%m-%d"),
            "accounts": deepcopy(accounts),
            "events": events,
        })
        current_date += datetime.timedelta(days=1)

    return forecast


def add_transaction(data, type):
    name = input(f"Enter {type} name: ")
    amount = input_float(f"Enter {type} amount: ")
    while True:
        frequency = input(
            f"Enter frequency ({'/'.join(FREQUENCIES)}): "
        ).lower().strip()
        if frequency in FREQUENCIES:
            break
        print(f"invalid option: {frequency}")

    today = datetime.date.today().strftime('%Y-%m-%d')
    next_date = input_date(
        f"Enter next due date (YYYY-MM-DD, default {today}): ",
        default=today)
    if frequency == "one-time":
        end_date = ""
    else:
        end_date = input_date(
            "Enter end date (YYYY-MM-DD) "
            "or nothing to repeat indefinitely: ",
            allow_empty=True)

    # Get the list of available accounts
    account_list = list(data["accounts"].keys())
    if not account_list:
        print("No accounts exist yet; "
              "let's create one before adding this entry.")
        add_account(data)
        account_list = list(data["accounts"].keys())

    # Display available accounts and prompt for selection
    print("Available accounts:")
    for i, account in enumerate(account_list, 1):
        print(f"{i}. {account}")

    default_account = account_list[0]

    while True:
        account_choice = input(
            f"Enter the account number for this {type} (default: 1): ")
        if account_choice == "":
            selected_account = default_account
            break
        try:
            account_index = int(account_choice) - 1
            if 0 <= account_index < len(account_list):
                selected_account = account_list[account_index]
                break
            print("Invalid account number. Please try again.")
        except ValueError:
            print("Please enter a valid number.")

    data[type].append({
        "name": name,
        "amount": amount,
        "frequency": frequency,
        "next_date": next_date,
        "end_date": end_date,
        "account": selected_account,
    })


def setup_wizard(data, filename):
    print(f"\n=== Setup wizard: {filename} ===")
    print("Walk through creating accounts, income, and expenses.")
    print("Ctrl-C aborts without saving.\n")

    print("--- Accounts ---")
    while True:
        add_account(data)
        if not input_yes_no("Add another account? (y/N): "):
            break

    print("\n--- Income ---")
    while input_yes_no("Add an income entry? (Y/n): ", default=True):
        add_transaction(data, "income")

    print("\n--- Expenses ---")
    while input_yes_no("Add an expense? (Y/n): ", default=True):
        add_transaction(data, "expenses")

    save_data(data, filename)
    print(f"\nSaved {filename}.")


color_red = "\033[0;31m"
color_cyan = "\033[0;36m"
color_green = "\033[0;32m"
color_reset = "\033[0m"
color_yellow = "\033[0;33m"


def _snapshot(data):
    """Stable serialization used for dirty-tracking."""
    return json.dumps(data, sort_keys=True)


def _print_forecast(forecast, months):
    """Print event rows and summary stats.

    Stats are computed against the sum of all account balances so the
    numbers make sense with per-transaction accounts.
    """
    balance_start = None
    balance_end = None
    balance_low = None
    balance_high = None
    date_start = None
    date_end = None
    date_low = None
    date_high = None

    for day in forecast:
        total = round(sum(day['accounts'].values()), 2)
        if balance_start is None:
            balance_start = total
            date_start = day['date']
        balance_end = total
        date_end = day['date']
        if balance_low is None or total < balance_low:
            balance_low = total
            date_low = day['date']
        if balance_high is None or total > balance_high:
            balance_high = total
            date_high = day['date']

        if not day['events']:
            continue
        print(f"Date: {day['date']}")
        for event in day['events']:
            account_name = event['account_name']
            balance = round(event['account_balance'], 2)
            amount = round(event['amount'], 2)
            color = color_red if event['type'] == 'expense' else color_green
            amount_s = f"{color}{amount}{color_reset}"
            neg = color_red if balance < 0 else ""
            reset = color_reset if balance < 0 else ""
            bal_s = f"{neg}{balance}{reset}"
            print(
                f"\t{account_name}\t{bal_s}\t{event['type']}"
                f"\t{amount_s} - {event['name']}"
            )

    if balance_start is None:
        print("No days in forecast; nothing to summarize.")
        return
    delta = balance_end - balance_start
    rate = delta / months if months else 0.0
    print(f'Start: {balance_start} - {date_start}')
    print(f'End:   {balance_end} - {date_end}')
    print(f'High:  {balance_high} - {date_high}')
    print(f'Low:   {balance_low} - {date_low}')
    print(f'Net:   {delta:.2f} over {months} month(s)')
    print(f'Rate:  ${rate:.2f}/month')


# TODO: Ideas
# - Keep original next_date, don't save over the original value when
#   performing a forecast.
# - Similar to above, allow saving forecasts so that we can compare
#   over time.
def main():
    parser = argparse.ArgumentParser(description="Financial Forecasting Tool")
    parser.add_argument("filename", help="JSON file to store data")
    parser.add_argument("--init", action="store_true",
                        help="run the guided setup wizard (also offered "
                             "when the file does not exist)")
    args = parser.parse_args()

    data = load_data(args.filename)

    run_wizard = args.init
    if not run_wizard and not os.path.exists(args.filename):
        run_wizard = input_yes_no(
            f"{args.filename} not found. "
            "Create it with the setup wizard? (Y/n): ",
            default=True)
    if run_wizard:
        setup_wizard(data, args.filename)

    baseline = _snapshot(data)

    while True:
        print("\n1. Add account")
        print("2. Add income")
        print("3. Add expense")
        print("4. Generate forecast")
        print("5. Save")
        print("6. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_account(data)
        elif choice == "2":
            add_transaction(data, "income")
        elif choice == "3":
            add_transaction(data, "expenses")
        elif choice == "4":
            try:
                months = int(input("Number of months to forecast: "))
            except ValueError:
                print("Please enter an integer number of months.")
                continue
            try:
                forecast = generate_forecast(data, months)
            except ValueError as e:
                print(f"Cannot forecast: {e}")
                continue
            _print_forecast(forecast, months)
        elif choice == "5":
            save_data(data, args.filename)
            baseline = _snapshot(data)
            print(f"Saved {args.filename}.")
        elif choice == "6":
            if _snapshot(data) != baseline:
                if input_yes_no(
                        "Unsaved changes. Save before exiting? (Y/n): ",
                        default=True):
                    save_data(data, args.filename)
                    print(f"Saved {args.filename}.")
            break
        elif choice == "9":
            breakpoint()
        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
